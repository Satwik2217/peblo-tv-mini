# Database
DATABASE_URL=postgresql+asyncpg://peblo:peblo@localhost:5432/peblo_tv
DATABASE_URL_SYNC=postgresql://peblo:peblo@localhost:5432/peblo_tv

# Authentication
JWT_SECRET=dev-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# Storage
STORAGE_BACKEND=local
STORAGE_PATH=./storage

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# API
API_URL=http://localhost:8000

# Frontend URLs
CMS_URL=http://localhost:5173
VIEWER_URL=http://localhost:5174
